# RetailPulse Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# MySQL Data Warehouse Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=retailpulse_dw
MYSQL_USER=retailpulse_user
MYSQL_PASSWORD=your_secure_password_here

# Pipeline Settings
APP_ENV=development
LOG_LEVEL=INFO
BATCH_SIZE=5000
SPARK_APP_NAME=RetailPulseETL
SPARK_MASTER=local[*]
